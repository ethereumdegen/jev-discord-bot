# Degen Guard (guard.degenbuilders.com). The same variables on all three services.
APP_ENV=production
APP_BASE_URL=https://guard.degenbuilders.com
BRAND=Degen Guard
DATABASE_URL=              # Neon (pooled)
# Direct (unpooled) URL for migrations; falls back to DATABASE_URL.
MIGRATION_DATABASE_URL=
REDIS_URL=                 # Upstash: rediss://default:<password>@<host>:6379
TYPESAFE_API_KEY=          # your Jev key (you pay for every judged message)
DEFAULT_MONTHLY_ALLOWANCE=2000
OPERATOR_EMAILS=you@example.com       # who sees /operator (every server, allowances)

# The Discord application (developer portal):
#  - OAuth2 redirect: https://guard.degenbuilders.com/api/auth/discord/callback
#  - Bot: Message Content intent ON (privileged; Discord must approve it past 100 servers)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# Sign-in: degenbuilders.com keeps the accounts, this site just asks it who you
# are. Required in production. The same client id and secret go in that site's
# SSO_CLIENTS, together with this site's callback:
#   SSO_CLIENTS=degen-guard|<the same secret>|https://guard.degenbuilders.com/api/auth/sso/callback
SSO_BASE_URL=https://degenbuilders.com
SSO_CLIENT_ID=degen-guard
SSO_CLIENT_SECRET=
SSO_LABEL=Degen Builders
